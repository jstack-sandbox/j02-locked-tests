test("CONTACT-002/F2 firm B never sees a firm A contact") {
  contact = as_operator("firm A").save_contact(name: "Dana Ruiz")
  expect(as_operator("firm B").get(contact.address).status).to_equal("not found")
}

test("CONTACT-003/E1 stores the contact's firm") {
  contact = as_operator("firm A").save_contact(name: "Dana Ruiz")
  expect(contact.firm).to_equal("firm A")
}
